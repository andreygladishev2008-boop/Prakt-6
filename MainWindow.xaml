<Window x:Class="Практика_6.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Практика_6"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Background="{DynamicResource ResourceKey=WindowBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="Title" Grid.Column="0" HorizontalAlignment="Center" TextWrapping="Wrap" Text="Name" VerticalAlignment="Top" Margin="10"/>
            <ComboBox x:Name="Equalizer" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="120" Margin="10" SelectionChanged="Folder_SelectionChanged">
                <ComboBoxItem Content="Equalizer 1"/>
                <ComboBoxItem Content="Equalizer 2"/>
                <ComboBoxItem Content="Equalizer 3"/>
                <ComboBoxItem Content="Equalizer 4"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Width="150">
            <CheckBox x:Name="Theme" Grid.Column="2" Content="Dark theme" Margin="10" Click="Theme_Checked"/>
            <RadioButton x:Name="Cycle" Grid.Column="2" Content="Cycle" Margin="10" Checked="Cycle_Checked"/>
        </StackPanel>

        <ProgressBar x:Name="Progress" Grid.Row="1" Grid.ColumnSpan="3" HorizontalAlignment="Center" Height="25" VerticalAlignment="Top" Width="500"/>

        <Button Style="{DynamicResource BaseButtonStyle}" x:Name="Previous" Grid.Column="0" Grid.Row="2" Content="Previous" HorizontalAlignment="Right" VerticalAlignment="Top" MinWidth="75" Click="Previous_Click"/>
        <Button Style="{DynamicResource DangerButton}" x:Name="Play" Grid.Column="1" Grid.Row="2" Content="Play" HorizontalAlignment="Center" VerticalAlignment="Top" MinWidth="75" Click="Play_Click"/>
        <Button Style="{DynamicResource BaseButtonStyle}" x:Name="Next" Grid.Column="2" Grid.Row="2" Content="Next" HorizontalAlignment="Left" VerticalAlignment="Top" MinWidth="75" Click="Next_Click"/>

    </Grid>
</Window>
